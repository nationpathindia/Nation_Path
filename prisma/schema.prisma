generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////
enum Role {
  superadmin
  admin
  editor
  reporter
  advertiser
  user
}

enum PostStatus {
  pending
  approved
  rejected
  draft
  archived
}

//////////////////////////////////////////////////////
// AD SYSTEM ENUMS
//////////////////////////////////////////////////////

enum AdPlacement {
  homepage_top
  homepage_after_hero
  homepage_mid
  homepage_after_list
  homepage_sidebar_top
  homepage_sidebar_bottom
  homepage_bottom

  article_top
  article_after_hero
  article_after_paragraph
  article_mid
  article_bottom

  category_top
  category_after_3_posts
  category_sidebar
  category_bottom
}

enum AdType {
  image
  adsense
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  //////////////////////////////////////////////////////
  // BASIC INFORMATION
  //////////////////////////////////////////////////////

  name        String
  slug        String  @unique
  description String?

  //////////////////////////////////////////////////////
  // NATIONPATH INTELLIGENCE
  //////////////////////////////////////////////////////

  intelligenceLabel String?

  //////////////////////////////////////////////////////
  // UI / BRAND CONTROL
  //////////////////////////////////////////////////////

  color String?

  //////////////////////////////////////////////////////
  // STATUS & ORDER
  //////////////////////////////////////////////////////

  status   String @default("active")
  priority Int    @default(0)

  //////////////////////////////////////////////////////
  // SEO
  //////////////////////////////////////////////////////

  seoTitle       String?
  seoDescription String?

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  articles        Article[]
  analyticsEvents CategoryAnalyticsEvent[]

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([status])
  @@index([priority])
  @@map("Category")
}

//////////////////////////////////////////////////////
// ARTICLE
//////////////////////////////////////////////////////

model Article {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  title String
  slug  String @unique

  content String
  excerpt String?

  //////////////////////////////////////////////////////
  // MEDIA
  //////////////////////////////////////////////////////

  images       String[]
  imageGallery Json?
  imageMeta    Json?

  videoUrl       String?
  videoTitle     String?
  videoPosition  String?
  videoEmbed     String?
  videoThumbnail String?

  //////////////////////////////////////////////////////
  // ANALYTICS
  //////////////////////////////////////////////////////

  analyticsEvents ArticleAnalyticsEvent[]

  //////////////////////////////////////////////////////
  // FLAGS
  //////////////////////////////////////////////////////

  breaking      Boolean @default(false)
  flash         Boolean @default(false)
  featured      Boolean @default(false)
  isEditorial   Boolean @default(false)
  isAstrology   Boolean @default(false)
  isDeleted     Boolean @default(false)
  isEditorsPick Boolean @default(false)
  isLive        Boolean @default(false)

  breakingStart DateTime?
  breakingEnd   DateTime?

  homepagePriority Int @default(0)

  breakingPriority Int @default(0)
  flashPriority    Int @default(0)

  //////////////////////////////////////////////////////
  // ASTROLOGY
  //////////////////////////////////////////////////////

  zodiacSign      String?
  horoscopeDate   DateTime?
  zodiacDateRange String?

  lovePrediction    String?
  careerPrediction  String?
  financePrediction String?
  healthPrediction  String?
  travelPrediction  String?
  moodPrediction    String?

  dailyTheme       String?
  dailyAffirmation String?
  featuredQuote    String?

  luckyColor     String?
  luckyColorHex  String?
  luckyNumber    String?
  luckyTime      String?
  luckyDirection String?
  luckyGemstone  String?
  luckyMantra    String?

  luckyFlower String?
  luckyPlant  String?
  luckyFood   String?
  luckyMetal  String?

  loveScore    Int?
  careerScore  Int?
  financeScore Int?
  healthScore  Int?

  dayEnergy String?
  mood      String?
  bestTime  String?
  warning   String?

  loveCompatibility Int?
  careerGrowth      Int?
  wealthEnergy      Int?
  mentalPeace       Int?
  familyHarmony     Int?
  travelLuck        Int?
  overallLuck       Int?

  isFeaturedZodiac Boolean @default(false)

  astroTitle       String?
  astroDescription String?

  tithi     String?
  nakshatra String?
  yoga      String?
  karana    String?

  sunrise  String?
  sunset   String?
  moonrise String?
  moonset  String?

  rahuKaal   String?
  yamaganda  String?
  gulikaKaal String?

  abhijitMuhurat String?
  brahmaMuhurat  String?
  amritKaal      String?

  moonSign  String?
  sunSign   String?
  ascendant String?
  moonPhase String?

  currentTransit  String?
  planetInfluence String?

  mercuryStatus String?
  venusStatus   String?
  marsStatus    String?
  jupiterStatus String?
  saturnStatus  String?
  rahuStatus    String?
  ketuStatus    String?

  compatibleSigns String[]
  avoidSigns      String[]

  todayRemedy    String?
  chantMantra    String?
  donation       String?
  auspiciousWork String?
  avoidToday     String?

  fastingSuggestion String?
  deityOfTheDay     String?

  horoscopeImage String?
  instagramImage String?
  storyImage     String?
  squareImage    String?
  bannerImage    String?

  shareTitle       String?
  shareDescription String?
  shareUrl         String?

  //////////////////////////////////////////////////////
  // AI
  //////////////////////////////////////////////////////

  aiGenerated Boolean   @default(false)
  aiVersion   String?
  aiPrompt    String?
  generatedAt DateTime?
  aiSummary   Json?

  //////////////////////////////////////////////////////
  // INTERNAL
  //////////////////////////////////////////////////////

  astrologyVersion Int?      @default(1)
  lastAstroUpdate  DateTime?

  //////////////////////////////////////////////////////
  // STATUS
  //////////////////////////////////////////////////////

  status      PostStatus @default(pending)
  publishedAt DateTime?
  scheduledAt DateTime?

  //////////////////////////////////////////////////////
  // ENGAGEMENT
  //////////////////////////////////////////////////////

  views  Int @default(0)
  likes  Int @default(0)
  shares Int @default(0)

  insightful Int @default(0)
  important  Int @default(0)
  surprising Int @default(0)
  concerning Int @default(0)

  //////////////////////////////////////////////////////
  // EDITORIAL INTELLIGENCE
  //////////////////////////////////////////////////////

  keyHighlights String[]
  whyItMatters  String?

  //////////////////////////////////////////////////////
  // ARTICLE INTELLIGENCE V1
  //////////////////////////////////////////////////////

  shortBrief String?
  background String?

  timeline      Json?
  expertOpinion Json?
  factCheck     Json?

  whatsNext    String?
  keyTakeaways String[]
  sourceDesk   Json?

  //////////////////////////////////////////////////////
  // TRENDING
  //////////////////////////////////////////////////////

  trendingScore Int       @default(0)
  lastViewAt    DateTime?

  //////////////////////////////////////////////////////
  // TAGS
  //////////////////////////////////////////////////////

  tags String[]

  //////////////////////////////////////////////////////
  // SEO
  //////////////////////////////////////////////////////

  readingTime     Int?
  metaTitle       String?
  metaDescription String?
  faqItems        Json?
  metaKeywords    String?
  canonicalUrl    String?
  ogImage         String?
  structuredData  String?

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  categoryId String?   @db.ObjectId
  category   Category? @relation(fields: [categoryId], references: [id])

  authorId String? @db.ObjectId
  author   User?   @relation(fields: [authorId], references: [id])

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([status])
  @@index([createdAt])
  @@index([publishedAt])
  @@index([views])
  @@index([likes])
  @@index([trendingScore])
  @@index([breaking])
  @@index([flash])
  @@index([featured])
  @@index([homepagePriority])
  @@index([isEditorial])
  @@index([isAstrology])
  @@index([isDeleted])
  @@index([breaking, isDeleted, status, breakingEnd, breakingPriority, createdAt])
  @@map("Article")
}

//////////////////////////////////////////////////////
// ARTICLE ANALYTICS EVENT
//////////////////////////////////////////////////////

model ArticleAnalyticsEvent {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  //////////////////////////////////////////////////////
  // ARTICLE
  //////////////////////////////////////////////////////

  articleId String  @db.ObjectId
  article   Article @relation(fields: [articleId], references: [id])

  //////////////////////////////////////////////////////
  // EVENT
  //////////////////////////////////////////////////////

  eventType String

  //////////////////////////////////////////////////////
  // USER / SESSION
  //////////////////////////////////////////////////////

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  sessionId String?

  //////////////////////////////////////////////////////
  // REQUEST / DEVICE
  //////////////////////////////////////////////////////

  ip        String?
  userAgent String?
  referrer  String?

  //////////////////////////////////////////////////////
  // LOCATION
  //////////////////////////////////////////////////////
  //
  // Resolved from visitor request/IP.
  // Optional because location may not always resolve.
  //

  country     String?
  countryCode String?

  state  String?
  city   String?
  region String?

  latitude  Float?
  longitude Float?

  timezone String?

  //////////////////////////////////////////////////////
  // PAGE / SOURCE
  //////////////////////////////////////////////////////

  path     String?
  source   String?
  campaign String?

  //////////////////////////////////////////////////////
  // EXTRA EVENT DATA
  //////////////////////////////////////////////////////

  metadata Json?

  //////////////////////////////////////////////////////
  // TIMESTAMP
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([articleId])
  @@index([eventType])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([country, createdAt])
  @@index([countryCode, createdAt])
  @@index([state, createdAt])
  @@index([city, createdAt])
  @@index([articleId, eventType, createdAt])
  @@map("ArticleAnalyticsEvent")
}

//////////////////////////////////////////////////////
// CATEGORY ANALYTICS EVENT
//////////////////////////////////////////////////////

model CategoryAnalyticsEvent {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  //////////////////////////////////////////////////////
  // CATEGORY
  //////////////////////////////////////////////////////

  categoryId String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id])

  //////////////////////////////////////////////////////
  // EVENT
  //////////////////////////////////////////////////////

  eventType String

  //////////////////////////////////////////////////////
  // USER / SESSION
  //////////////////////////////////////////////////////

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  sessionId String?

  //////////////////////////////////////////////////////
  // REQUEST / DEVICE
  //////////////////////////////////////////////////////

  ip        String?
  userAgent String?
  referrer  String?

  //////////////////////////////////////////////////////
  // LOCATION
  //////////////////////////////////////////////////////

  country     String?
  countryCode String?

  state  String?
  city   String?
  region String?

  latitude  Float?
  longitude Float?

  timezone String?

  //////////////////////////////////////////////////////
  // PAGE / SOURCE
  //////////////////////////////////////////////////////

  path     String?
  source   String?
  campaign String?

  //////////////////////////////////////////////////////
  // EXTRA EVENT DATA
  //////////////////////////////////////////////////////

  metadata Json?

  //////////////////////////////////////////////////////
  // TIMESTAMP
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([categoryId])
  @@index([eventType])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([country, createdAt])
  @@index([countryCode, createdAt])
  @@index([state, createdAt])
  @@index([city, createdAt])
  @@index([categoryId, eventType, createdAt])
  @@map("CategoryAnalyticsEvent")
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////
//
// SINGLE CANONICAL USER MODEL
//
// MongoDB collection:
//   users
//
// Authentication:
// - Email + password
// - Google
// - Phone OTP
// - Email OTP
//
// IMPORTANT:
// - There is ONE User model.
// - There is ONE canonical users collection.
// - All authentication methods resolve to this User.
//
//////////////////////////////////////////////////////

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  //////////////////////////////////////////////////////
  // BASIC PROFILE
  //////////////////////////////////////////////////////

  name   String?
  email  String? @unique
  avatar String?

  //////////////////////////////////////////////////////
  // LEGACY / PROFILE DATA
  //////////////////////////////////////////////////////

  profile      Json?
  permissions  Json?
  birthProfile Json?
  subscription Json?

  //////////////////////////////////////////////////////
  // AUTHENTICATION
  //////////////////////////////////////////////////////

  password String?

  // credentials | google | otp
  provider   String  @default("credentials")
  providerId String?

  lastLoginAt DateTime?

  //////////////////////////////////////////////////////
  // ACCOUNT STATUS
  //////////////////////////////////////////////////////

  role     Role     @default(user)
  status   String   @default("active")
  isActive Boolean? @default(true)

  //////////////////////////////////////////////////////
  // PHONE IDENTITIES
  //////////////////////////////////////////////////////

  phoneNumbers UserPhone[]

  //////////////////////////////////////////////////////
  // EMAIL IDENTITIES
  //////////////////////////////////////////////////////

  emailAddresses          UserEmail[]
  emailVerificationTokens EmailVerificationToken[]

  //////////////////////////////////////////////////////
  // OTP RECORDS
  //////////////////////////////////////////////////////

  otps UserOtp[]

  //////////////////////////////////////////////////////
  // CONTENT RELATIONS
  //////////////////////////////////////////////////////

  articles Article[]

  //////////////////////////////////////////////////////
  // ANALYTICS RELATIONS
  //////////////////////////////////////////////////////

  articleAnalyticsEvents  ArticleAnalyticsEvent[]
  categoryAnalyticsEvents CategoryAnalyticsEvent[]

  //////////////////////////////////////////////////////
  // ACTIVITY
  //////////////////////////////////////////////////////

  activity ActivityLog[]

  //////////////////////////////////////////////////////
  // POLLS
  //////////////////////////////////////////////////////

  createdPolls Poll[]
  pollVotes    PollVote[]

  //////////////////////////////////////////////////////
  // CHAT
  //////////////////////////////////////////////////////

  sentMessages     ChatMessage[] @relation("MessageSender")
  receivedMessages ChatMessage[] @relation("MessageReceiver")

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  //////////////////////////////////////////////////////
  // CANONICAL MONGODB COLLECTION
  //////////////////////////////////////////////////////

  @@index([role])
  @@index([isActive])
  @@index([status])
  @@index([provider])
  @@index([providerId])
  @@map("users")
}

//////////////////////////////////////////////////////
// USER PHONE
//
// Stores phone identities belonging to a User.
//
// Phone numbers are globally unique.
//
// Phone format:
//   E.164
//
// Example:
//   +919876543210
//
//////////////////////////////////////////////////////

model UserPhone {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  //////////////////////////////////////////////////////
  // PHONE
  //////////////////////////////////////////////////////

  phone String @unique

  //////////////////////////////////////////////////////
  // VERIFICATION
  //////////////////////////////////////////////////////

  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  //////////////////////////////////////////////////////
  // OWNERSHIP
  //////////////////////////////////////////////////////

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  //////////////////////////////////////////////////////
  // COLLECTION
  //////////////////////////////////////////////////////

  @@index([userId])
  @@index([isVerified])
  @@map("UserPhone")
}

//////////////////////////////////////////////////////
// USER EMAIL
//
// Stores email identities belonging to a User.
//
// Email verification is independent from phone
// verification.
//
//////////////////////////////////////////////////////

model UserEmail {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  //////////////////////////////////////////////////////
  // EMAIL
  //////////////////////////////////////////////////////

  email String @unique

  //////////////////////////////////////////////////////
  // VERIFICATION
  //////////////////////////////////////////////////////

  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  //////////////////////////////////////////////////////
  // OWNERSHIP
  //////////////////////////////////////////////////////

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  //////////////////////////////////////////////////////
  // COLLECTION
  //////////////////////////////////////////////////////

  @@index([userId])
  @@index([isVerified])
  @@map("UserEmail")
}

//////////////////////////////////////////////////////
// USER OTP
//
// Temporary OTP authentication records.
//
// Supports:
// - Phone OTP
// - Email OTP
//
// IMPORTANT:
// - NEVER store plaintext OTP.
// - Only otpHash is stored.
// - OTP may exist before a User account exists.
//
//////////////////////////////////////////////////////

model UserOtp {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  //////////////////////////////////////////////////////
  // OTP CHANNEL
  //
  // phone
  // email
  //
  //////////////////////////////////////////////////////

  channel String @default("phone")

  //////////////////////////////////////////////////////
  // DESTINATION
  //
  // Phone example:
  //   +919876543210
  //
  // Email example:
  //   user@example.com
  //
  //////////////////////////////////////////////////////

  phone String?
  email String?

  //////////////////////////////////////////////////////
  // OTP SECURITY
  //////////////////////////////////////////////////////

  otpHash String

  expiresAt  DateTime
  consumedAt DateTime?

  //////////////////////////////////////////////////////
  // PURPOSE
  //
  // login
  // signup
  // verify_phone
  // verify_email
  // change_phone
  // change_email
  // reset_password
  //
  //////////////////////////////////////////////////////

  purpose String @default("login")

  //////////////////////////////////////////////////////
  // SECURITY / RATE LIMITING
  //////////////////////////////////////////////////////

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  //////////////////////////////////////////////////////
  // USER LINK
  //
  // Optional because OTP may be created before
  // the User account exists.
  //
  //////////////////////////////////////////////////////

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  //////////////////////////////////////////////////////
  // TIMESTAMP
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  //////////////////////////////////////////////////////
  // COLLECTION
  //////////////////////////////////////////////////////

  @@index([phone])
  @@index([email])
  @@index([channel])
  @@index([userId])
  @@index([expiresAt])
  @@index([purpose])
  @@index([createdAt])
  @@map("UserOtp")
}

//////////////////////////////////////////////////////
// EMAIL VERIFICATION TOKEN
//////////////////////////////////////////////////////

model EmailVerificationToken {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  tokenHash String @unique

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  email String

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("EmailVerificationToken")
}

//////////////////////////////////////////////////////
// CHAT MESSAGE
//////////////////////////////////////////////////////

model ChatMessage {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  //////////////////////////////////////////////////////
  // SENDER
  //////////////////////////////////////////////////////

  senderId String? @db.ObjectId

  sender User? @relation("MessageSender", fields: [senderId], references: [id])

  //////////////////////////////////////////////////////
  // RECEIVER
  //////////////////////////////////////////////////////

  receiverId String? @db.ObjectId

  receiver User? @relation("MessageReceiver", fields: [receiverId], references: [id])

  //////////////////////////////////////////////////////
  // MESSAGE
  //////////////////////////////////////////////////////

  message String
  isRead  Boolean @default(false)

  //////////////////////////////////////////////////////
  // TIMESTAMP
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@map("ChatMessage")
}

//////////////////////////////////////////////////////
// AD SYSTEM
//////////////////////////////////////////////////////

model Ad {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  title     String
  placement AdPlacement
  type      AdType

  imageUrl    String?
  link        String?
  adsenseCode String?

  priority Int    @default(1)
  status   String @default("active")

  startDate DateTime?
  endDate   DateTime?

  totalBudget Float?
  cpc         Float?
  maxClicks   Int?

  views     Int     @default(0)
  clicks    Int     @default(0)
  completed Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([placement])
  @@index([status])
  @@index([priority])
  @@map("Ad")
}

//////////////////////////////////////////////////////
// NEWSLETTER
//////////////////////////////////////////////////////

model NewsletterSubscriber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("NewsletterSubscriber")
}

//////////////////////////////////////////////////////
// ACTIVITY LOG
//////////////////////////////////////////////////////

model ActivityLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  action   String
  entity   String?
  entityId String?

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("ActivityLog")
}

//////////////////////////////////////////////////////
// VISITOR CHAT
//////////////////////////////////////////////////////

model VisitorChat {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name    String?
  email   String?
  message String

  ip        String?
  userAgent String?

  isRead Boolean @default(false)
  status String  @default("open")

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([isRead])
  @@index([status])
  @@map("VisitorChat")
}

//////////////////////////////////////////////////////
// POLL SYSTEM
//////////////////////////////////////////////////////

model Poll {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  //////////////////////////////////////////////////////
  // CONTENT
  //////////////////////////////////////////////////////

  question String

  slug String? @unique

  category String?

  //////////////////////////////////////////////////////
  // STATUS
  //////////////////////////////////////////////////////

  status String @default("draft")

  //////////////////////////////////////////////////////
  // PUBLISH CONTROL
  //////////////////////////////////////////////////////

  publishedAt DateTime?

  expiresAt DateTime?

  //////////////////////////////////////////////////////
  // ENGAGEMENT
  //////////////////////////////////////////////////////

  totalVotes Int @default(0)

  //////////////////////////////////////////////////////
  // CREATOR
  //////////////////////////////////////////////////////

  createdById String? @db.ObjectId

  createdBy User? @relation(fields: [createdById], references: [id])

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  options PollOption[]

  votes PollVote[]

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime? @updatedAt

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([status])
  @@index([publishedAt])
  @@index([expiresAt])
  @@map("Poll")
}

//////////////////////////////////////////////////////
// POLL OPTION
//////////////////////////////////////////////////////

model PollOption {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  text String

  votes Int @default(0)

  pollId String @db.ObjectId

  poll Poll @relation(fields: [pollId], references: [id])

  pollVotes PollVote[]

  createdAt DateTime @default(now())

  @@index([pollId])
  @@map("PollOption")
}

//////////////////////////////////////////////////////
// POLL VOTE
//////////////////////////////////////////////////////

model PollVote {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  pollId String @db.ObjectId

  optionId String @db.ObjectId

  userId String? @db.ObjectId

  user User? @relation(fields: [userId], references: [id])

  poll Poll @relation(fields: [pollId], references: [id])

  option PollOption @relation(fields: [optionId], references: [id])

  ip String?

  userAgent String?

  createdAt DateTime @default(now())

  @@index([pollId])
  @@index([optionId])
  @@index([userId])
  @@index([createdAt])
  @@map("PollVote")
}
