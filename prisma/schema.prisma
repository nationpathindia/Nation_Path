generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Role {
  admin
  editor
  reporter
  advertiser
  user
}

enum PostStatus {
  pending
  approved
  rejected
  draft
  archived
}

//////////////////////////////////////////////////////
// AD SYSTEM ENUMS
//////////////////////////////////////////////////////

enum AdPlacement {
  homepage_top
  homepage_after_hero
  homepage_mid
  homepage_after_list
  homepage_sidebar_top
  homepage_sidebar_bottom
  homepage_bottom

  article_top
  article_after_hero
  article_after_paragraph
  article_mid
  article_bottom

  category_top
  category_after_3_posts
  category_sidebar
  category_bottom
}

enum AdType {
  image
  adsense
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////


model Category {

  id          String  @id @default(auto()) @map("_id") @db.ObjectId


  //////////////////////////////////////////////////////
  // BASIC INFORMATION
  //////////////////////////////////////////////////////

  name        String
  slug        String  @unique
  description String?



  //////////////////////////////////////////////////////
  // NATIONPATH INTELLIGENCE
  //////////////////////////////////////////////////////

  intelligenceLabel String?



  //////////////////////////////////////////////////////
  // UI / BRAND CONTROL
  //////////////////////////////////////////////////////

  color String?



  //////////////////////////////////////////////////////
  // STATUS & ORDER
  //////////////////////////////////////////////////////

  status   String @default("active")
  priority Int    @default(0)



  //////////////////////////////////////////////////////
  // SEO
  //////////////////////////////////////////////////////

  seoTitle       String?
  seoDescription String?



  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt



  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  articles Article[]



  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([status])
  @@index([priority])
  @@map("Category")

}

//////////////////////////////////////////////////////
// ARTICLE
//////////////////////////////////////////////////////

model Article {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  title String
  slug  String @unique

  content String
  excerpt String?

  images   String[]
  imageGallery Json?
  imageMeta Json?
  videoUrl String?
videoPosition String?



  //////////////////////////////////////////////////////
  // FLAGS
  //////////////////////////////////////////////////////

  breaking      Boolean @default(false)
  flash         Boolean @default(false)
  featured      Boolean @default(false)
  isEditorial   Boolean @default(false)
  isAstrology   Boolean @default(false)
  isDeleted     Boolean @default(false)
  isEditorsPick Boolean @default(false)
  isLive        Boolean @default(false)

  breakingStart DateTime?

  breakingEnd DateTime?
  
  homepagePriority Int @default(0)

  breakingPriority Int @default(0)
  flashPriority    Int @default(0)


  ///////////////////////////////////////////////////////////////////////////////////////////////////////
  // ASTROLOGY
  ///////////////////////////////////////////////////////////////////////////////////////////////////////

  // ==========================================================
  // BASIC HOROSCOPE
  // ==========================================================

  zodiacSign      String?
  horoscopeDate   DateTime?
  zodiacDateRange String?

  // ==========================================================
  // DAILY HOROSCOPE
  // ==========================================================

  lovePrediction    String?
  careerPrediction  String?
  financePrediction String?
  healthPrediction  String?
  travelPrediction  String?
  moodPrediction    String?

  dailyTheme       String?
  dailyAffirmation String?
  featuredQuote    String?

  // ==========================================================
  // LUCKY INSIGHTS
  // ==========================================================

  luckyColor     String?
  luckyColorHex  String?
  luckyNumber    String?
  luckyTime      String?
  luckyDirection String?
  luckyGemstone  String?
  luckyMantra    String?

  luckyFlower String?
  luckyPlant  String?
  luckyFood   String?
  luckyMetal  String?

  // ==========================================================
  // ENERGY SCORES
  // ==========================================================

  loveScore    Int?
  careerScore  Int?
  financeScore Int?
  healthScore  Int?
  dayEnergy String?
mood String?
bestTime String?
warning String?

  loveCompatibility Int?
  careerGrowth      Int?
  wealthEnergy      Int?
  mentalPeace       Int?
  familyHarmony     Int?
  travelLuck        Int?
  overallLuck       Int?

  // ==========================================================
  // FEATURED
  // ==========================================================

  isFeaturedZodiac Boolean @default(false)

  // ==========================================================
  // ASTROLOGY SEO
  // ==========================================================

  astroTitle       String?
  astroDescription String?

  // ==========================================================
  // PANCHANG
  // ==========================================================

  tithi     String?
  nakshatra String?
  yoga      String?
  karana    String?

  sunrise  String?
  sunset   String?
  moonrise String?
  moonset  String?

  rahuKaal   String?
  yamaganda  String?
  gulikaKaal String?

  abhijitMuhurat String?
  brahmaMuhurat  String?
  amritKaal      String?

  // ==========================================================
  // PLANETARY DETAILS
  // ==========================================================

  moonSign  String?
  sunSign   String?
  ascendant String?
  moonPhase String?

  currentTransit  String?
  planetInfluence String?

  mercuryStatus String?
  venusStatus   String?
  marsStatus    String?
  jupiterStatus String?
  saturnStatus  String?
  rahuStatus    String?
  ketuStatus    String?

  // ==========================================================
  // COMPATIBILITY
  // ==========================================================

  compatibleSigns String[]
  avoidSigns      String[]

  // ==========================================================
  // REMEDIES
  // ==========================================================

  todayRemedy    String?
  chantMantra    String?
  donation       String?
  auspiciousWork String?
  avoidToday     String?

  fastingSuggestion String?
  deityOfTheDay     String?

  // ==========================================================
  // IMAGES
  // ==========================================================

  horoscopeImage String?
  instagramImage String?
  storyImage     String?
  squareImage    String?
  bannerImage    String?

  // ==========================================================
  // SOCIAL SHARE
  // ==========================================================

  shareTitle       String?
  shareDescription String?
  shareUrl         String?

  // ==========================================================
  // AI
  // ==========================================================

  aiGenerated Boolean   @default(false)
  aiVersion   String?
  aiPrompt    String?
  generatedAt DateTime?
  aiSummary   Json?
  // ==========================================================
  // INTERNAL
  // ==========================================================

  astrologyVersion Int?      @default(1)
  lastAstroUpdate  DateTime?

  //////////////////////////////////////////////////////
  // STATUS
  //////////////////////////////////////////////////////

  status      PostStatus @default(pending)
  publishedAt DateTime?

  //////////////////////////////////////////////////////
  // ENGAGEMENT
  //////////////////////////////////////////////////////

  views  Int @default(0)
  likes  Int @default(0)
  shares Int @default(0)

  insightful Int @default(0)
  important  Int @default(0)
  surprising Int @default(0)
  concerning Int @default(0)


  //////////////////////////////////////////////////////
  // EDITORIAL INTELLIGENCE
  //////////////////////////////////////////////////////

  keyHighlights String[]

  whyItMatters String?

//////////////////////////////////////////////////////
// ARTICLE INTELLIGENCE V1
//////////////////////////////////////////////////////

shortBrief String?

background String?

timeline Json?

expertOpinion Json?

factCheck Json?

whatsNext String?

keyTakeaways String[]

sourceDesk Json?


  //////////////////////////////////////////////////////
  // TRENDING
  //////////////////////////////////////////////////////

  trendingScore Int       @default(0)
  lastViewAt    DateTime?

  //////////////////////////////////////////////////////
  // TAGS
  //////////////////////////////////////////////////////

  tags String[]

  //////////////////////////////////////////////////////
  // SEO
  //////////////////////////////////////////////////////

  readingTime     Int?
  metaTitle       String?
  metaDescription String?
 faqItems        Json?
  metaKeywords    String?
  canonicalUrl    String?
  ogImage         String?
  structuredData  String?

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  categoryId String?   @db.ObjectId
  category   Category? @relation(fields: [categoryId], references: [id])

  authorId String? @db.ObjectId
  author   User?   @relation(fields: [authorId], references: [id])

  comments Comment[]

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([status])
  @@index([createdAt])
  @@index([publishedAt])
  @@index([views])
  @@index([likes])
  @@index([trendingScore])
  @@index([breaking])
  @@index([flash])
  @@index([featured])
  @@index([homepagePriority])
  @@index([isEditorial])
  @@index([isAstrology])
  @@index([isDeleted])
  @@map("Article")
}

//////////////////////////////////////////////////////
// COMMENT
//////////////////////////////////////////////////////

model Comment {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  content String

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  articleId String  @db.ObjectId
  article   Article @relation(fields: [articleId], references: [id])

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([articleId])
  @@index([createdAt])
  @@map("Comment")
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name     String?
  email    String  @unique
  password String

  role     Role    @default(user)
  isActive Boolean @default(true)
  avatar   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  articles Article[]
  comments Comment[]
  activity ActivityLog[]
  createdPolls Poll[]

pollVotes PollVote[]

  sentMessages     ChatMessage[] @relation("MessageSender")
  receivedMessages ChatMessage[] @relation("MessageReceiver")

  @@index([role])
  @@index([isActive])
  @@map("User")
}

//////////////////////////////////////////////////////
// CHAT
//////////////////////////////////////////////////////

model ChatMessage {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  senderId String? @db.ObjectId
  sender   User?   @relation("MessageSender", fields: [senderId], references: [id])

  receiverId String? @db.ObjectId
  receiver   User?   @relation("MessageReceiver", fields: [receiverId], references: [id])

  message String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@map("ChatMessage")
}

//////////////////////////////////////////////////////
// AD SYSTEM
//////////////////////////////////////////////////////

model Ad {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  title     String
  placement AdPlacement
  type      AdType

  imageUrl    String?
  link        String?
  adsenseCode String?

  priority Int    @default(1)
  status   String @default("active")

  startDate DateTime?
  endDate   DateTime?

  totalBudget Float?
  cpc         Float?
  maxClicks   Int?

  views     Int     @default(0)
  clicks    Int     @default(0)
  completed Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([placement])
  @@index([status])
  @@index([priority])
  @@map("Ad")
}

//////////////////////////////////////////////////////
// NEWSLETTER
//////////////////////////////////////////////////////

model NewsletterSubscriber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("NewsletterSubscriber")
}

//////////////////////////////////////////////////////
// ACTIVITY LOG
//////////////////////////////////////////////////////

model ActivityLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  action   String
  entity   String?
  entityId String?

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("ActivityLog")
}

//////////////////////////////////////////////////////
// VISITOR CHAT
//////////////////////////////////////////////////////

model VisitorChat {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name    String?
  email   String?
  message String

  ip        String?
  userAgent String?

  isRead Boolean @default(false)
  status String  @default("open")

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([isRead])
  @@index([status])
  @@map("VisitorChat")
}
//////////////////////////////////////////////////////
// POLL SYSTEM
//////////////////////////////////////////////////////

model Poll {

  id String @id @default(auto()) @map("_id") @db.ObjectId



  //////////////////////////////////////////////////////
  // CONTENT
  //////////////////////////////////////////////////////

  question String

 slug String? @unique

  category String?



  //////////////////////////////////////////////////////
  // STATUS
  //////////////////////////////////////////////////////

  status String @default("draft")



  //////////////////////////////////////////////////////
  // PUBLISH CONTROL
  //////////////////////////////////////////////////////

  publishedAt DateTime?

  expiresAt DateTime?



  //////////////////////////////////////////////////////
  // ENGAGEMENT
  //////////////////////////////////////////////////////

  totalVotes Int @default(0)



  //////////////////////////////////////////////////////
  // CREATOR
  //////////////////////////////////////////////////////

  createdById String? @db.ObjectId

  createdBy User? @relation(fields: [createdById], references: [id])



  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  options PollOption[]

  votes PollVote[]



  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime? @updatedAt



  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([status])

  @@index([publishedAt])

  @@index([expiresAt])

  @@map("Poll")

}









//////////////////////////////////////////////////////
// POLL OPTION
//////////////////////////////////////////////////////

model PollOption {


  id String @id @default(auto()) @map("_id") @db.ObjectId



  text String


  votes Int @default(0)



  pollId String @db.ObjectId


  poll Poll @relation(fields: [pollId], references: [id])


  pollVotes PollVote[]



  createdAt DateTime @default(now())



  @@index([pollId])


  @@map("PollOption")

}









//////////////////////////////////////////////////////
// POLL VOTE
//////////////////////////////////////////////////////

model PollVote {


  id String @id @default(auto()) @map("_id") @db.ObjectId



  pollId String @db.ObjectId


  optionId String @db.ObjectId



  userId String? @db.ObjectId



  user User? @relation(fields: [userId], references: [id])



  poll Poll @relation(fields: [pollId], references: [id])


  option PollOption @relation(fields: [optionId], references: [id])



  ip String?


  userAgent String?



  createdAt DateTime @default(now())



  @@index([pollId])

  @@index([optionId])

  @@index([userId])

  @@index([createdAt])


  @@map("PollVote")

}